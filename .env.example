# Copy to .env.local (gitignored) and fill in. NEVER commit real values.
# Production values live in the Render dashboard (backend) and Neon (database), see docs/SECRETS.md.

# --- Backend (Render env vars) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=                     # Render generates this (render.yaml)
APP_ADMIN_EMAILS=               # comma separated; these accounts get ROLE_ADMIN at sign-in
BREVO_API_KEY=                  # email OTP delivery
BREVO_SENDER_EMAIL=
MAINTENANCE_TOKEN=              # shared secret for /internal/maintenance/* (long random string); unset disables them
GOOGLE_CLIENT_ID=               # optional Google sign-in (also set VITE_GOOGLE_CLIENT_ID when building the frontend)
VAPID_PUBLIC_KEY=               # web push: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=       # Android push (Firebase service account JSON, single line)

# --- Local-only testing (never set these on Render) ---
AUTH_MASTER_OTP=                # dev OTP shortcut; only works while BREVO_API_KEY is empty
APP_AUTH_VERIFICATION_BYPASS_EMAILS=   # accounts that skip signup email verification

# --- Test accounts used by scripts/local-smoke.sh ---
SETTLEHUB_ADMIN_EMAIL=
SETTLEHUB_ADMIN_PASSWORD=
SETTLEHUB_TEST1_EMAIL=
SETTLEHUB_TEST1_PASSWORD=
